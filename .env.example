NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://dream_journal:replace-password@localhost:5432/dream_journal
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
JOURNAL_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
ENABLE_EXPERIMENTAL_FEATURES=false
BACKUP_PROVIDER=disabled
REMINDER_PROVIDER=disabled

